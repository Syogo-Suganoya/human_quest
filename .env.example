DATABASE_URL=postgres://humanquest:humanquest@localhost:5436/humanquest

# 未設定でも動作するが、AI課題選定・AIフィードバックがルールベースの
# 固定文言にフォールバックする
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# 未設定時はローカルの public/uploads/ に保存される（ローカル開発ではそのままでOK）。
# 本番（Firebase App Hosting）では Firebase Storage のバケット名を設定する（DEPLOY.md 参照）
FIREBASE_STORAGE_BUCKET=
